---
import { getCollection } from "astro:content";
import { siteConfig } from "../config/site";
import { sortPosts } from "../utils/posts";

const allPosts = await getCollection("posts");
const activePosts = sortPosts(allPosts);
const recentPosts = activePosts.slice(0, 5);

const categoryCounts = activePosts.reduce((acc, post) => {
  const category = post.data.category || "未分类";
  acc[category] = (acc[category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categories = Object.entries(categoryCounts)
  .sort(([, leftCount], [, rightCount]) => rightCount - leftCount)
  .map(([name, count]) => ({ name, count }));

const tags = Array.from(
  activePosts.reduce((acc, post) => {
    post.data.tags?.forEach((tag) => acc.add(tag));
    return acc;
  }, new Set<string>())
).slice(0, 12);

const yearCounts = Object.entries(
  activePosts.reduce((acc, post) => {
    const year = `${post.data.date.getFullYear()}`;
    acc[year] = (acc[year] || 0) + 1;
    return acc;
  }, {} as Record<string, number>)
)
  .sort(([leftYear], [rightYear]) => Number(rightYear) - Number(leftYear))
  .slice(0, 5);

const quickLinks = [
  { label: "文章归档", href: "/posts/", desc: "按时间线查看全部文章" },
  { label: "站内搜索", href: "/search/", desc: "快速定位关键词与主题" },
  { label: "关于作者", href: "/about/", desc: "了解写作方向与背景" },
  { label: "RSS 订阅", href: "/rss.xml", desc: "保持低干扰内容跟进" },
];

const referenceLinks = [
  { label: "科学空间", href: "https://spaces.ac.cn", desc: "值得长期学习的中文技术博客" },
  { label: "Astro", href: "https://astro.build", desc: "本站使用的静态站点框架" },
  { label: "Pagefind", href: "https://pagefind.app", desc: "站内搜索能力的来源" },
];
---

<div class="sidebar">
  <section class="widget author-card card">
    <p class="widget-kicker">About This Site</p>
    <div class="author-header">
      <div class="avatar-fallback">WYS</div>
      <div class="author-info">
        <h3>{siteConfig.author}</h3>
        <p class="role">AI 研究 · 工程实践 · 长线写作</p>
      </div>
    </div>

    <p class="bio">
      这里持续记录大模型、检索增强、训练优化和工程落地中的问题、方法与复盘，希望每篇文章都能在后续工作里继续被复用。
    </p>

    <dl class="author-stats">
      <div>
        <dt>文章</dt>
        <dd>{activePosts.length}</dd>
      </div>
      <div>
        <dt>专题</dt>
        <dd>{categories.length}</dd>
      </div>
      <div>
        <dt>标签</dt>
        <dd>{tags.length}</dd>
      </div>
    </dl>

    <div class="author-actions">
      <a href={siteConfig.github} target="_blank" rel="noopener noreferrer" class="author-action">
        GitHub
      </a>
      <a href="/rss.xml" class="author-action">RSS</a>
    </div>
  </section>

  <section class="widget card">
    <h3 class="widget-title">站点索引</h3>
    <div class="quick-links">
      {
        quickLinks.map((link) => (
          <a href={link.href} class="quick-link">
            <span class="quick-link-label">{link.label}</span>
            <span class="quick-link-desc">{link.desc}</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="widget card">
    <h3 class="widget-title">近期文章</h3>
    <ul class="recent-list">
      {
        recentPosts.map((post) => (
          <li>
            <a href={`/posts/${post.id}/`} class="recent-item">
              <span class="recent-title">{post.data.title}</span>
              <span class="recent-date">
                {post.data.date.toLocaleDateString("zh-CN", { month: "2-digit", day: "2-digit" })}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="widget card">
    <h3 class="widget-title">年度写作</h3>
    <ul class="year-list">
      {
        yearCounts.map(([year, count]) => (
          <li>
            <span>{year}</span>
            <strong>{count} 篇</strong>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="widget card">
    <h3 class="widget-title">栏目分类</h3>
    <ul class="category-list">
      {
        categories.map((cat) => (
          <li>
            <a href={`/categories/${encodeURIComponent(cat.name)}/`} class="category-item">
              <span class="category-name">{cat.name}</span>
              <span class="category-count">{cat.count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {tags.length > 0 && (
    <section class="widget card">
      <h3 class="widget-title">常用标签</h3>
      <div class="tag-cloud">
        {tags.map((tag) => <a href={`/tags/${encodeURIComponent(tag)}/`} class="tag-pill">#{tag}</a>)}
      </div>
    </section>
  )}

  <section class="widget card">
    <h3 class="widget-title">参考链接</h3>
    <div class="reference-list">
      {
        referenceLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noopener noreferrer" class="reference-item">
            <span class="reference-label">{link.label}</span>
            <span class="reference-desc">{link.desc}</span>
          </a>
        ))
      }
    </div>
  </section>
</div>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .widget {
    padding: 1.2rem;
  }

  .widget-kicker {
    margin: 0 0 0.85rem;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .widget-title {
    margin: 0 0 0.9rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--accent);
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .author-card {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface-strong) 90%, transparent) 0%, var(--surface) 100%);
  }

  .author-header {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 0.9rem;
  }

  .avatar-fallback {
    width: 3.25rem;
    height: 3.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-strong) 100%);
    color: #fff7ef;
    font-family: "Source Serif 4", "Noto Serif SC", serif;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .author-info h3 {
    margin: 0;
    font-size: 1.08rem;
  }

  .role {
    margin: 0.18rem 0 0;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .bio {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.72;
  }

  .author-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
    margin: 1rem 0 0;
  }

  .author-stats div {
    border: 1px solid color-mix(in srgb, var(--line) 92%, transparent);
    border-radius: var(--radius-md);
    padding: 0.7rem 0.5rem;
    text-align: center;
    background: color-mix(in srgb, var(--surface-strong) 88%, transparent);
  }

  .author-stats dt {
    color: var(--muted);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .author-stats dd {
    margin: 0.25rem 0 0;
    font-family: "Source Serif 4", "Noto Serif SC", serif;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1;
  }

  .author-actions {
    display: flex;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .author-action {
    flex: 1;
    text-align: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.5rem 0.75rem;
    color: var(--text);
    font-size: 0.88rem;
    font-weight: 600;
    background: var(--surface-strong);
  }

  .author-action:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .quick-links,
  .reference-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .quick-link,
  .reference-item {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    border: 1px solid color-mix(in srgb, var(--line) 92%, transparent);
    border-radius: var(--radius-md);
    padding: 0.8rem 0.85rem;
    color: inherit;
    background: color-mix(in srgb, var(--surface-strong) 90%, transparent);
  }

  .quick-link:hover,
  .reference-item:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 55%, var(--surface-strong));
  }

  .quick-link-label,
  .reference-label {
    font-weight: 700;
    color: var(--text);
  }

  .quick-link-desc,
  .reference-desc {
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .recent-list,
  .category-list,
  .year-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .recent-list li,
  .year-list li {
    border-bottom: 1px dashed color-mix(in srgb, var(--line) 92%, transparent);
  }

  .recent-list li:last-child,
  .year-list li:last-child {
    border-bottom: none;
  }

  .recent-item {
    display: flex;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.72rem 0;
    color: inherit;
  }

  .recent-title {
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .recent-item:hover .recent-title {
    color: var(--accent);
  }

  .recent-date {
    flex-shrink: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .year-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.72rem 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .year-list strong {
    color: var(--text);
    font-size: 0.86rem;
  }

  .category-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .category-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: var(--radius-md);
    padding: 0.55rem 0.7rem;
    color: var(--text);
    background: color-mix(in srgb, var(--surface-strong) 88%, transparent);
    border: 1px solid color-mix(in srgb, var(--line) 92%, transparent);
  }

  .category-item:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 55%, var(--surface-strong));
  }

  .category-name {
    font-size: 0.9rem;
  }

  .category-count {
    min-width: 2rem;
    text-align: center;
    border-radius: 999px;
    padding: 0.08rem 0.45rem;
    background: color-mix(in srgb, var(--surface-muted) 92%, transparent);
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .tag-pill {
    border: 1px solid color-mix(in srgb, var(--line) 92%, transparent);
    border-radius: 999px;
    padding: 0.18rem 0.58rem;
    color: var(--muted);
    font-size: 0.8rem;
    background: color-mix(in srgb, var(--surface-strong) 88%, transparent);
  }

  .tag-pill:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
</style>
